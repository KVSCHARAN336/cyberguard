  "version": "1.0.0",
  "description": "Production-grade Cyber Security Hosting & Tech Stack Detection Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
